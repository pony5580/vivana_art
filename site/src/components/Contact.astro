---
import { site } from '../data/site';
---

<section class="section section--board contact" id="contact">
  <div class="wrap contact__wrap">
    <p class="eyebrow">Contact</p>
    <h2 class="contact__title">
      まずは体験レッスンへ。<br />
      お気軽に、遊びにきてください。
    </h2>
    <p class="contact__lead">
      ご予約・ご質問は公式LINEから。<br class="sp-only" />
      いちばんスムーズにやりとりできます。
    </p>

    <div class="contact__actions">
      <a class="btn btn--line contact__line" href={site.line} target="_blank" rel="noopener">
        公式LINEで体験を申し込む
      </a>
      <a class="contact__ig" href={site.instagram} target="_blank" rel="noopener">
        Instagram
        <span>{site.instagramHandle}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact__wrap {
    max-width: var(--wrap-narrow);
    text-align: center;
  }
  .contact__title {
    font-size: clamp(1.6rem, 4.5vw, 2.6rem);
    font-weight: 900;
    line-height: 1.45;
    margin-top: 0.5rem;
  }
  .contact__lead {
    color: var(--chalk-dim);
    margin-top: 1rem;
  }
  .contact__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2.2rem;
  }
  .contact__line {
    font-size: 1.1rem;
    padding: 1em 2.2em;
  }
  .contact__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--chalk);
    border-bottom: 2px dashed rgba(247, 244, 236, 0.4);
    padding-bottom: 3px;
  }
  .contact__ig span {
    color: var(--sun);
    font-family: var(--font-hand);
    font-size: 1.15rem;
  }
  .contact__ig:hover {
    color: var(--sun);
  }
  .sp-only {
    display: none;
  }
  @media (max-width: 560px) {
    .sp-only {
      display: inline;
    }
  }
</style>
