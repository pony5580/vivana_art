---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { site } from '../data/site';
import group from '../assets/photos/group-chalk.jpg';
import shell from '../assets/photos/chalk-shell-making.jpg';
---

<section class="hero" id="top">
  <div class="hero__wrap wrap">
    <div class="hero__copy">
      <Logo size={120} variant="board" />
      <p class="hero__tag">{site.tagline}</p>
      <h1 class="hero__catch">
        <span class="nb">夢中になる時間が、</span>
        <span class="nb">自分の<span class="hero__mark">「好き」</span>を育てる。</span>
      </h1>
      <p class="hero__sub">
        横浜・金沢文庫の小さなアトリエ。<br />
        チョークアート、ねんど、絵の具。<br />
        こどもたちが色に夢中になる場所です。
      </p>
      <div class="hero__cta">
        <a class="btn btn--line" href={site.line} target="_blank" rel="noopener">
          体験を申し込む（LINE）
        </a>
        <a class="btn btn--ghost" href="#class">コースを見る</a>
      </div>
    </div>

    <div class="hero__art" aria-hidden="false">
      <figure class="photo photo--1">
        <Image src={group} alt="チョークアートの作品を掲げるこどもたち" widths={[360, 640]} sizes="(max-width:900px) 80vw, 420px" />
      </figure>
      <figure class="photo photo--2">
        <Image src={shell} alt="オイルパステルでチョークアートを描くこども" widths={[260, 440]} sizes="(max-width:900px) 50vw, 260px" />
      </figure>
    </div>
  </div>

  <!-- 手描きチョークのあしらい -->
  <svg class="hero__doodle hero__doodle--star" viewBox="0 0 40 40" aria-hidden="true">
    <path d="M20 3 L23 15 L36 15 L26 23 L30 36 L20 28 L10 36 L14 23 L4 15 L17 15 Z"
      fill="none" stroke="#f2b807" stroke-width="2" stroke-linejoin="round" />
  </svg>
  <svg class="hero__doodle hero__doodle--squiggle" viewBox="0 0 120 24" aria-hidden="true">
    <path d="M2 12 Q17 2 32 12 T62 12 T92 12 T118 12" fill="none"
      stroke="#e86fa0" stroke-width="3" stroke-linecap="round" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 80% at 15% 0%, #2b3a31 0%, var(--board) 55%, var(--board-deep) 100%);
    color: var(--chalk);
    overflow: hidden;
    /* かすかなチョークの粉 */
    background-blend-mode: normal;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(247, 244, 236, 0.06) 1px, transparent 1px);
    background-size: 4px 4px;
    pointer-events: none;
  }
  .hero__wrap {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .hero__tag {
    font-family: var(--font-hand);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    color: var(--sun);
    margin-top: 1rem;
    line-height: 1;
  }
  .hero__catch {
    font-size: clamp(1.7rem, 5vw, 3.15rem);
    font-weight: 900;
    line-height: 1.4;
    margin-top: 0.6rem;
    letter-spacing: 0.03em;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
  }
  /* 語中で改行させない（チャンク単位で折り返す） */
  .hero__catch .nb {
    display: inline-block;
    white-space: nowrap;
  }
  .hero__mark {
    color: var(--sun);
    position: relative;
    white-space: nowrap;
  }
  .hero__sub {
    margin-top: 1.4rem;
    color: var(--chalk-dim);
    font-size: 1.02rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  /* 貼り付けた写真 風 */
  .hero__art {
    position: relative;
    min-height: 340px;
  }
  .photo {
    background: #fff;
    padding: 10px 10px 44px;
    border-radius: 4px;
    box-shadow: 0 22px 50px -20px rgba(0, 0, 0, 0.7);
    position: relative;
  }
  .photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .photo::before {
    /* マスキングテープ */
    content: '';
    position: absolute;
    top: -12px;
    left: 50%;
    width: 86px;
    height: 26px;
    transform: translateX(-50%) rotate(-4deg);
    background: rgba(242, 184, 7, 0.55);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  .photo--1 {
    width: min(78%, 400px);
    transform: rotate(-3deg);
    margin-left: auto;
  }
  .photo--2 {
    width: min(46%, 230px);
    transform: rotate(5deg);
    position: absolute;
    left: 0;
    bottom: -8%;
  }
  .photo--2::before {
    background: rgba(46, 159, 176, 0.6);
    transform: translateX(-50%) rotate(6deg);
  }

  .hero__doodle {
    position: absolute;
    pointer-events: none;
  }
  .hero__doodle--star {
    width: 46px;
    top: 12%;
    right: 46%;
    animation: twinkle 3.5s ease-in-out infinite;
  }
  .hero__doodle--squiggle {
    width: 130px;
    bottom: 8%;
    right: 8%;
    opacity: 0.8;
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.4; transform: scale(0.9) rotate(-4deg); }
    50% { opacity: 1; transform: scale(1.05) rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__doodle--star { animation: none; }
  }

  @media (max-width: 900px) {
    .hero__wrap {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero :global(.logo) {
      margin-inline: auto;
    }
    .hero__cta {
      justify-content: center;
    }
    .hero__art {
      order: -1;
      min-height: 300px;
      margin-bottom: 1rem;
    }
    .photo--1 { margin-inline: auto; }
    .photo--2 { left: 2%; }
  }
</style>
