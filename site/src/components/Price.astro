---
import { priceMeta } from '../data/site';

// 曜日別タイムテーブル
const timetable = [
  {
    day: '月・木',
    slots: [
      { name: 'キッズ', time: '15:30–17:00', color: 'var(--kids)' },
      { name: 'ジュニア', time: '17:00–18:30', color: 'var(--junior)' },
    ],
  },
  {
    day: '土',
    slots: [
      { name: 'キッズ', time: '9:00–10:30', color: 'var(--kids)' },
      { name: 'ジュニア', time: '10:30–12:00', color: 'var(--junior)' },
      { name: 'ユース', time: '10:30–12:00 / 13:30–15:30', color: 'var(--youth)' },
    ],
  },
];
---

<section class="section price" id="price">
  <div class="wrap price__wrap">
    <header class="price__head">
      <p class="eyebrow">Price</p>
      <h2 class="heading">料金と、レッスンの時間割。</h2>
    </header>

    <div class="price__admission">
      <div>
        <span class="price__label">入会費</span>
        <b class="price__amount">{priceMeta.admission}</b>
      </div>
      <p class="price__freq">
        レッスンは <b>{priceMeta.frequency}</b>。
        コース別の月謝は各コースをご覧ください。
      </p>
    </div>

    <div class="timetable">
      {
        timetable.map((row) => (
          <div class="timetable__row">
            <div class="timetable__day">{row.day}</div>
            <div class="timetable__slots">
              {row.slots.map((s) => (
                <div class="slot" style={`--c:${s.color}`}>
                  <b>{s.name}</b>
                  <span>{s.time}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .price__wrap {
    max-width: 900px;
  }
  .price__head {
    text-align: center;
    margin-bottom: 2.2rem;
  }
  .price__admission {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    background: var(--board);
    color: var(--chalk);
    border-radius: var(--radius);
    padding: 1.4rem 1.8rem;
    margin-bottom: 1.4rem;
  }
  .price__label {
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--sun);
    font-weight: 700;
    display: block;
  }
  .price__amount {
    font-size: 2rem;
    font-weight: 900;
    line-height: 1.1;
  }
  .price__freq {
    color: var(--chalk-dim);
    font-size: 0.95rem;
    max-width: 34ch;
  }
  .price__freq b {
    color: var(--chalk);
  }

  .timetable {
    display: grid;
    gap: 0.8rem;
  }
  .timetable__row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1rem;
    align-items: center;
    background: #fff;
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    box-shadow: var(--shadow-soft);
  }
  .timetable__day {
    font-size: 1.3rem;
    font-weight: 900;
    text-align: center;
    color: var(--ink);
  }
  .timetable__slots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .slot {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5em 0.9em;
    border-left: 4px solid var(--c);
    background: var(--paper);
    border-radius: 8px;
    min-width: 8.5em;
  }
  .slot b {
    color: var(--c);
    font-size: 0.9rem;
  }
  .slot span {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  @media (max-width: 560px) {
    .timetable__row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .timetable__day {
      text-align: left;
    }
  }
</style>
